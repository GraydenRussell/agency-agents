# Copy to .env.local and fill in. Never commit .env.local.

# Public https URL in production: quote links sent to customers use it.
APP_URL=http://localhost:3000

# ── Database (Supabase → Project Settings → Database) ──
# Pooled (transaction mode, port 6543) for the app; direct (5432) for migrations.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-1.pooler.supabase.com:5432/postgres
# Optional: Postgres pool size per server instance (default 5)
# DB_POOL_MAX=5

# ── Auth ──
# supabase = real login + required TOTP 2FA. dev = no login (local only; refused on Vercel).
AUTH_MODE=supabase
ALLOWED_EMAIL=you@example.com
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Security ──
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32   (pg_cron sends this to /api/cron/*)
CRON_SECRET=

# ── Integrations ──
# mock = seed/fixture-backed adapters (no external calls). live = real APIs.
INTEGRATION_MODE=mock

# Anthropic (Phase 4–5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Model for high-volume work (email triage). Defaults to Opus at low effort; set claude-haiku-5-5 to cut cost.
ANTHROPIC_FAST_MODEL=claude-opus-5-5

# Google OAuth: Gmail + Calendar (Phase 3–4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio SMS (Phase 6)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MY_PHONE_NUMBER=

# Web push (Phase 6) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Projects hub (Phase 7)
GITHUB_TOKEN=
GITHUB_OWNERS=GraydenRussell
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# For `npm run sync:local` (local project folders → app). openssl rand -hex 24
PROJECTS_SYNC_TOKEN=

# Business hub (Phase 8)
ADMIN_DASH_URL=
LIFE_OS_API_TOKEN=

# Housecall Pro (Phase 11): App Store → API (MAX plan). Read-only use.
HOUSECALL_PRO_API_KEY=

# Lead inbox (Phase 11.3). Website forms POST to /api/leads/webhook with this secret
# (npm run setup:secrets generates it and META_VERIFY_TOKEN).
LEAD_WEBHOOK_SECRET=
# Meta Lead Ads webhook → /api/leads/meta (App secret, your verify token, Page token with leads_retrieval)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Weather (Open-Meteo, no key). Defaults to Chandler, AZ.
WEATHER_LAT=33.3062
WEATHER_LON=-111.8413
